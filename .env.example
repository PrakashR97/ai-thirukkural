# Used by docker-compose.yml (project root). Backend secrets live in backend/.env.
POSTGRES_PASSWORD=change_me_to_a_long_random_password
# Your domain (DNS A record -> server IP). Caddy gets a free HTTPS certificate for it.
# Leave unset (or ':80') for plain HTTP on the server IP.
DOMAIN=kural.example.com
# Hostname for the Traefik overlay (docker-compose.traefik.yml)
APP_HOST=kural.example.com
# Local port the website listens on (127.0.0.1 only). Point your existing reverse proxy here.
APP_PORT=8081
# Only for the optional `--profile caddy` mode:
HTTP_PORT=80
