# Used by docker-compose.yml (project root). Backend secrets live in backend/.env.
POSTGRES_PASSWORD=change_me_to_a_long_random_password
# Your domain (DNS A record -> server IP). Caddy gets a free HTTPS certificate for it.
# Leave unset (or ':80') for plain HTTP on the server IP.
DOMAIN=kural.example.com
# Host port for plain HTTP (default 80). HTTPS always uses 443.
HTTP_PORT=80
