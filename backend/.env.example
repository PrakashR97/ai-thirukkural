OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-4o-mini
SERPER_API_KEY=your_serper_api_key
# PostgreSQL cache. Leave blank to use a local SQLite file instead.
DATABASE_URL=postgresql://your_user@localhost:5432/thirukkural
# Optional: USD per 1M tokens, used only for cost estimates (leave blank to disable)
PRICE_INPUT_PER_1M=
PRICE_OUTPUT_PER_1M=
# Comma-separated allowed frontend origins
CORS_ORIGINS=http://localhost:5173
# Limits on NEW paid generations (cached Kurals are always free). 0 disables a limit.
RATE_LIMIT_PER_HOUR=10
DAILY_GENERATION_CAP=300
